                            <ul class="role-responsibilities">
                                <li data-translate="role_backend_1">Carbon API development</li>
                                <li data-translate="role_backend_2">Cloud infrastructure</li>
                                <li data-translate="role_backend_3">Database architecture</li>
                            </ul>
