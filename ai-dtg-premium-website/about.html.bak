                            <div class="role-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" width="80" height="80">
                                    <defs>
                                        <linearGradient id="frontendGradient" x1="0%" y1="0%" x2="100%" y2="100%">
