            <div class="team-roles">
                <!-- Leadership -->
                <div class="role-category">
                    <h3 class="role-category-title" data-translate="team_leadership">Leadership</h3>
                    <div class="role-grid">
                        <div class="role-card">
                            <div class="role-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" width="80" height="80">
                                    <defs>
                                        <linearGradient id="ceoGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                                            <stop offset="0%" style="stop-color:#8b5cf6;stop-opacity:1" />
                                            <stop offset="100%" style="stop-color:#6366f1;stop-opacity:1" />
                                        </linearGradient>
                                    </defs>
                                    <circle cx="100" cy="100" r="90" fill="rgba(139, 92, 246, 0.1)" stroke="url(#ceoGradient)" stroke-width="2"/>
                                    <!-- Person silhouette -->
                                    <circle cx="100" cy="75" r="25" fill="url(#ceoGradient)"/>
                                    <path d="M60 140 Q100 110 140 140 L140 160 L60 160 Z" fill="url(#ceoGradient)"/>
                                    <!-- Crown/leadership symbol -->
                                    <path d="M85 50 L90 60 L100 55 L110 60 L115 50 L112 70 L88 70 Z" fill="#fbbf24" opacity="0.9"/>
                                </svg>
                            </div>
                            <h4 class="role-title" data-translate="role_ceo">CEO</h4>
                            <ul class="role-responsibilities">
                                <li data-translate="role_ceo_1">Strategic direction & vision</li>
                                <li data-translate="role_ceo_2">Government relations & partnerships</li>
                                <li data-translate="role_ceo_3">Business development</li>
                            </ul>
                        </div>

                        <div class="role-card">
                            <div class="role-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" width="80" height="80">
                                    <defs>
                                        <linearGradient id="ctoGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                                            <stop offset="0%" style="stop-color:#06b6d4;stop-opacity:1" />
                                            <stop offset="100%" style="stop-color:#0891b2;stop-opacity:1" />
                                        </linearGradient>
                                    </defs>
                                    <circle cx="100" cy="100" r="90" fill="rgba(6, 182, 212, 0.1)" stroke="url(#ctoGradient)" stroke-width="2"/>
                                    <!-- Person silhouette -->
                                    <circle cx="100" cy="75" r="25" fill="url(#ctoGradient)"/>
                                    <path d="M60 140 Q100 110 140 140 L140 160 L60 160 Z" fill="url(#ctoGradient)"/>
                                    <!-- Chip/tech symbol -->
                                    <rect x="85" y="40" width="30" height="30" fill="none" stroke="#22d3ee" stroke-width="3" rx="3"/>
                                    <circle cx="91" cy="46" r="2" fill="#22d3ee"/>
                                    <circle cx="109" cy="46" r="2" fill="#22d3ee"/>
                                    <circle cx="91" cy="64" r="2" fill="#22d3ee"/>
                                    <circle cx="109" cy="64" r="2" fill="#22d3ee"/>
                                </svg>
                            </div>
                            <h4 class="role-title" data-translate="role_cto">CTO</h4>
                            <ul class="role-responsibilities">
                                <li data-translate="role_cto_1">Technology strategy & R&D</li>
                                <li data-translate="role_cto_2">ISO-14083 compliance oversight</li>
                                <li data-translate="role_cto_3">Technical architecture</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- R&D Team -->
                <div class="role-category">
                    <h3 class="role-category-title" data-translate="team_rd">Research & Development</h3>
                    <div class="role-grid">
                        <div class="role-card">
                            <div class="role-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" width="80" height="80">
                                    <defs>
                                        <linearGradient id="carbonGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                                            <stop offset="0%" style="stop-color:#10b981;stop-opacity:1" />
                                            <stop offset="100%" style="stop-color:#059669;stop-opacity:1" />
                                        </linearGradient>
                                    </defs>
                                    <circle cx="100" cy="100" r="90" fill="rgba(16, 185, 129, 0.1)" stroke="url(#carbonGradient)" stroke-width="2"/>
                                    <!-- Beaker/flask -->
                                    <path d="M80 60 L80 90 L70 130 Q70 145 85 145 L115 145 Q130 145 130 130 L120 90 L120 60 Z"
                                          fill="none" stroke="url(#carbonGradient)" stroke-width="3"/>
                                    <rect x="75" y="50" width="50" height="10" fill="url(#carbonGradient)"/>
                                    <!-- Liquid -->
                                    <path d="M75 110 L72 130 Q72 140 85 140 L115 140 Q128 140 128 130 L125 110 Z"
                                          fill="url(#carbonGradient)" opacity="0.4"/>
                                    <!-- Bubbles -->
                                    <circle cx="90" cy="120" r="3" fill="#ffffff" opacity="0.6"/>
                                    <circle cx="105" cy="115" r="4" fill="#ffffff" opacity="0.6"/>
                                </svg>
                            </div>
                            <h4 class="role-title" data-translate="role_carbon">Carbon Emission Specialist</h4>
                            <ul class="role-responsibilities">
                                <li data-translate="role_carbon_1">WTW emission factor research</li>
                                <li data-translate="role_carbon_2">ISO-14083 algorithm development</li>
                                <li data-translate="role_carbon_3">Carbon calculation engine</li>
                            </ul>
                        </div>

                        <div class="role-card">
                            <div class="role-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" width="80" height="80">
                                    <defs>
                                        <linearGradient id="aiGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                                            <stop offset="0%" style="stop-color:#ec4899;stop-opacity:1" />
                                            <stop offset="100%" style="stop-color:#d946ef;stop-opacity:1" />
                                        </linearGradient>
                                    </defs>
                                    <circle cx="100" cy="100" r="90" fill="rgba(236, 72, 153, 0.1)" stroke="url(#aiGradient)" stroke-width="2"/>
                                    <!-- Robot head -->
                                    <rect x="70" y="70" width="60" height="50" fill="url(#aiGradient)" rx="10"/>
                                    <!-- Eyes -->
                                    <circle cx="85" cy="90" r="6" fill="#ffffff"/>
                                    <circle cx="115" cy="90" r="6" fill="#ffffff"/>
                                    <!-- Antenna -->
                                    <line x1="100" y1="70" x2="100" y2="50" stroke="url(#aiGradient)" stroke-width="3"/>
                                    <circle cx="100" cy="50" r="5" fill="#22d3ee"/>
                                    <!-- Mouth/neural network pattern -->
                                    <path d="M80 105 Q100 110 120 105" stroke="#ffffff" stroke-width="2" fill="none"/>
                                    <circle cx="85" cy="110" r="2" fill="#22d3ee"/>
                                    <circle cx="100" cy="112" r="2" fill="#22d3ee"/>
                                    <circle cx="115" cy="110" r="2" fill="#22d3ee"/>
                                </svg>
                            </div>
                            <h4 class="role-title" data-translate="role_ai">AI Engineer</h4>
                            <ul class="role-responsibilities">
                                <li data-translate="role_ai_1">AI inference model development</li>
                                <li data-translate="role_ai_2">Edge computing optimization</li>
                                <li data-translate="role_ai_3">Driver safety AI systems</li>
                            </ul>
                        </div>

                        <div class="role-card">
                            <div class="role-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" width="80" height="80">
                                    <defs>
                                        <linearGradient id="hwGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                                            <stop offset="0%" style="stop-color:#f97316;stop-opacity:1" />
                                            <stop offset="100%" style="stop-color:#ea580c;stop-opacity:1" />
                                        </linearGradient>
                                    </defs>
                                    <circle cx="100" cy="100" r="90" fill="rgba(249, 115, 22, 0.1)" stroke="url(#hwGradient)" stroke-width="2"/>
                                    <!-- Gear shape -->
                                    <circle cx="100" cy="100" r="35" fill="url(#hwGradient)"/>
                                    <circle cx="100" cy="100" r="20" fill="rgba(0,0,0,0.3)"/>
                                    <!-- Gear teeth -->
                                    <rect x="95" y="55" width="10" height="12" fill="url(#hwGradient)"/>
                                    <rect x="95" y="133" width="10" height="12" fill="url(#hwGradient)"/>
                                    <rect x="55" y="95" width="12" height="10" fill="url(#hwGradient)"/>
                                    <rect x="133" y="95" width="12" height="10" fill="url(#hwGradient)"/>
                                    <rect x="70" y="70" width="10" height="10" fill="url(#hwGradient)" transform="rotate(-45 75 75)"/>
                                    <rect x="120" y="70" width="10" height="10" fill="url(#hwGradient)" transform="rotate(45 125 75)"/>
                                    <rect x="70" y="120" width="10" height="10" fill="url(#hwGradient)" transform="rotate(45 75 125)"/>
                                    <rect x="120" y="120" width="10" height="10" fill="url(#hwGradient)" transform="rotate(-45 125 125)"/>
                                </svg>
                            </div>
                            <h4 class="role-title" data-translate="role_hw">Hardware Engineer</h4>
                            <ul class="role-responsibilities">
                                <li data-translate="role_hw_1">DTG hardware design</li>
                                <li data-translate="role_hw_2">Sensor integration</li>
                                <li data-translate="role_hw_3">Manufacturing & quality control</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- Software Team -->
                <div class="role-category">
                    <h3 class="role-category-title" data-translate="team_software">Software Development</h3>
                    <div class="role-grid">
                        <div class="role-card">
                            <div class="role-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" width="80" height="80">
                                    <defs>
                                        <linearGradient id="backendGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                                            <stop offset="0%" style="stop-color:#3b82f6;stop-opacity:1" />
                                            <stop offset="100%" style="stop-color:#2563eb;stop-opacity:1" />
                                        </linearGradient>
                                    </defs>
                                    <circle cx="100" cy="100" r="90" fill="rgba(59, 130, 246, 0.1)" stroke="url(#backendGradient)" stroke-width="2"/>
                                    <!-- Server stack -->
                                    <rect x="60" y="70" width="80" height="20" fill="url(#backendGradient)" rx="3"/>
                                    <rect x="60" y="95" width="80" height="20" fill="url(#backendGradient)" rx="3"/>
                                    <rect x="60" y="120" width="80" height="20" fill="url(#backendGradient)" rx="3"/>
                                    <!-- Status lights -->
                                    <circle cx="70" cy="80" r="3" fill="#22c55e"/>
                                    <circle cx="80" cy="80" r="3" fill="#22c55e"/>
                                    <circle cx="70" cy="105" r="3" fill="#22c55e"/>
                                    <circle cx="80" cy="105" r="3" fill="#fbbf24"/>
                                    <circle cx="70" cy="130" r="3" fill="#22c55e"/>
                                    <circle cx="80" cy="130" r="3" fill="#22c55e"/>
                                </svg>
