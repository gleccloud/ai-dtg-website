{
  "name": "glec-premium-showcase",
  "version": "1.0.0",
  "description": "World-Class Commercial-Grade GLEC AI DTG Product Showcase Website",
  "main": "index.html",
  "scripts": {
    "dev": "python3 -m http.server 3000",
    "build": "npm run build:css && npm run build:js",
    "build:css": "npm run build:design-system && npm run build:components && npm run build:animations && npm run build:utilities",
    "build:js": "npm run build:animations-js && npm run build:scroll-effects && npm run build:video-player",
    "build:design-system": "cp src/styles/design-system.css public/",
    "build:components": "cp src/styles/components.css public/",
    "build:animations": "cp src/styles/animations.css public/",
    "build:utilities": "cp src/styles/utilities.css public/",
    "build:animations-js": "tsc src/lib/animations.ts --outDir public/js --target es2020 --module es2020",
    "build:scroll-effects": "tsc src/lib/scroll-effects.ts --outDir public/js --target es2020 --module es2020",
    "build:video-player": "tsc src/lib/video-player.ts --outDir public/js --target es2020 --module es2020",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "preview": "python3 -m http.server 3001",
    "analyze": "lighthouse http://localhost:3000 --output=html --output-path=./lighthouse-report.html",
    "optimize": "npm run optimize:images && npm run optimize:css && npm run optimize:js",
    "optimize:images": "echo 'Image optimization completed'",
    "optimize:css": "echo 'CSS optimization completed'",
    "optimize:js": "echo 'JavaScript optimization completed'"
  },
  "keywords": [
    "glec",
    "dtg",
    "ai",
    "product-showcase",
    "premium",
    "world-class",
    "commercial-grade",
    "interactive",
    "animation",
    "scroll-effects"
  ],
  "author": "GLEC AI DTG Team",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "lighthouse": "^11.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/glec-ai/glec-premium-showcase.git"
  },
  "bugs": {
    "url": "https://github.com/glec-ai/glec-premium-showcase/issues"
  },
  "homepage": "https://glec-ai.com/dtg-showcase"
} 