    <section class="transformation-section" id="transformation">
        <div class="section-container">
            <div class="section-header">
                <span class="section-label" data-translate="transformation_label">AI TRANSFORMATION</span>
                <h2 class="section-title" data-translate="transformation_title">AI Transformation (AX) for Old Freight Trucks</h2>
                <p class="section-description" data-translate="transformation_description">
                    Upgrade existing freight trucks to smart vehicles with cutting-edge AI technology<br>
                    Simultaneously achieve driver safety and environmental protection
                </p>
            </div>
            
            <!-- Transformation Video -->
            <div class="transformation-video-container">
                <video class="transformation-video" autoplay muted loop playsinline>
                    <source src="assets/videos/KakaoTalk_20250814_145511097.mp4" type="video/mp4">
                </video>
            </div>
            
            <!-- Transformation Features -->
            <div class="transformation-features">
                <div class="feature-card">
                    <h3 class="feature-title" data-translate="safety_title">AI-Based Driver and Cargo Safety Enhancement</h3>
                    <p class="feature-description" data-translate="safety_description">
                        Detect driver fatigue, drowsiness, and distraction through real-time AI inference<br>
                        and provide immediate alerts. Continuously monitor cargo status to<br>
                        prevent accidents and ensure safe transportation.
                    </p>
                </div>
                
                <div class="feature-card">
                    <h3 class="feature-title" data-translate="carbon_title">AI-Based International Standard Carbon Measurement and Reduction</h3>
                    <p class="feature-description" data-translate="carbon_description">
                        Precise carbon emission measurement system complying with ISO 14064 international standards<br>
                        Monitor real-time carbon emissions and maximize fuel efficiency through AI optimization<br>
                        to effectively reduce carbon emissions.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <section class="dtg-section" id="ai-dtg">
        <div class="section-container">
            <div class="section-header">
                <span class="section-label" data-translate="dtg_label">AI HARDWARE</span>
                <h2 class="section-title" data-translate="dtg_title">GLEC AI DTG</h2>
                <p class="section-description" data-translate="dtg_description">
                    Next-generation AI digital tachograph that monitors and optimizes<br>
                    driver safety and vehicle efficiency in real-time
                </p>
            </div>
            
            <!-- DTG Videos - Two videos side by side -->
            <div class="dtg-videos-container">
                <div class="dtg-video-wrapper">
                    <video class="dtg-video" autoplay muted loop playsinline>
                        <source src="assets/videos/dtg1.mp4" type="video/mp4">
                        Your browser does not support the video tag.
                    </video>
                </div>
                <div class="dtg-video-wrapper">
                    <video class="dtg-video" autoplay muted loop playsinline>
                        <source src="assets/videos/dtg2.mp4" type="video/mp4">
                        Your browser does not support the video tag.
                    </video>
                </div>
            </div>
            
            <!-- DTG Features -->
            <div class="transformation-features">
                <div class="feature-card">
                    <h3 class="feature-title" data-translate="ai_inference_title">Real-time AI Inference System</h3>
                    <p class="feature-description" data-translate="ai_inference_description">
                        Immediate risk detection and response possible with high-precision sensors and edge AI computing.<br>
                        Real-time analysis of driver status, road conditions, and cargo status<br>
                        to prevent accidents and ensure safe operation.
                    </p>
                </div>
                
                <div class="feature-card">
                    <h3 class="feature-title" data-translate="lte_cloud_title">LTE Connectivity & Cloud Integration</h3>
                    <p class="feature-description" data-translate="lte_cloud_description">
                        Transmit real-time data to the cloud through ultra-high-speed LTE network<br>
                        and provide insights through big data analysis. Real-time integration with vehicle control center<br>
                        enables immediate response.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <section class="dashboard-section" id="ai-dashboard">
        <div class="section-container">
            <div class="section-header">
                <span class="section-label" data-translate="dashboard_label">AI SOFTWARE</span>
                <h2 class="section-title" data-translate="dashboard_title">GLEC AI Dashboard</h2>
                <p class="section-description" data-translate="dashboard_description">
                    Integrated AI dashboard system that visualizes and analyzes<br>
                    vehicle operation data in real-time to provide optimal transportation efficiency
                </p>
            </div>
            
            <!-- Dashboard Video -->
            <div class="transformation-video-container">
                <video class="transformation-video dashboard-video" autoplay muted loop playsinline>
                    <source src="assets/videos/화면 기록 2025-08-19 오후 11.41.20.mov" type="video/quicktime">
                    <source src="assets/videos/화면 기록 2025-08-19 오후 11.41.20.mov" type="video/mp4">
                </video>
            </div>
            
            <!-- Dashboard Features -->
            <div class="transformation-features">
                <div class="feature-card">
                    <h3 class="feature-title" data-translate="data_visualization_title">Real-time Data Visualization</h3>
                    <p class="feature-description" data-translate="data_visualization_description">
                        Intuitive interface allows drivers and managers to grasp all information at a glance.<br>
                        Monitor and analyze all data including vehicle location, route, fuel consumption,<br>
                        carbon emissions in real-time.
                    </p>
                </div>
                
                <div class="feature-card">
                    <h3 class="feature-title" data-translate="voice_agent_title">AI Voice Conversational Agent</h3>
                    <p class="feature-description" data-translate="voice_agent_description">
                        Real-time AI voice recognition and conversation system provides immediate emergency safety alerts<br>
                        to drivers. Voice warnings during hazardous situations reduce accident rates by over 20%,<br>
                        supporting safe driving through natural conversations with drivers.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <section class="technology-section" id="technology">
        <div class="section-container">
            <div class="section-header">
                <span class="section-label" data-translate="technology_label">CORE TECHNOLOGY</span>
                <h2 class="section-title" data-translate="technology_title">Cutting-Edge AI & API Technology</h2>
                <p class="section-description" data-translate="technology_description">
                    World-leading AI technology and international standard carbon measurement API<br>
                    Creating sustainable logistics through innovation
                </p>
            </div>

            <!-- GLEC AI Technology -->
            <div class="tech-block">
                <div class="tech-header">
                    <h3 class="tech-title" data-translate="glec_ai_title">GLEC AI - 20B LLM Real-time Inference Engine</h3>
                    <span class="tech-badge" data-translate="ai_safety_badge">AI SAFETY</span>
                </div>

                <!-- GLEC AI Demo Video -->
                <div class="tech-video-container" style="width: 700px; height: 700px; max-width: 100%; margin: 20px auto; padding: 20px; box-sizing: border-box; display: flex; align-items: center; justify-content: center;">
                    <video class="tech-video" style="width: 700px; height: 700px; max-width: 100%; max-height: 100%; object-fit: contain; display: block;" autoplay muted loop playsinline preload="auto" id="glecAiVideo">
                        <source src="assets/videos/GLEC_AI_video.mov" type="video/quicktime">
                        <source src="assets/videos/GLEC_AI_video.mov" type="video/mp4">
                        Your browser does not support the video tag.
                    </video>
                </div>

                <div class="tech-grid">
                    <div class="tech-card">
                        <h4 data-translate="glec_ai_card1_title">20B Parameter LLM</h4>
                        <p data-translate="glec_ai_card1_desc">4-bit quantization for real-time inference with embedded weights from accident-prone area datasets (weather, time, location patterns)</p>
                    </div>

                    <div class="tech-card">
                        <h4 data-translate="glec_ai_card2_title">Real-time Data Integration</h4>
                        <p data-translate="glec_ai_card2_desc">CAN Protocol data, GPS tracking, live traffic incidents, and congestion information processed as real-time embedding weights</p>
                    </div>

                    <div class="tech-card">
                        <h4 data-translate="glec_ai_card3_title">Vehicle Context Protocol (VCP)</h4>
                        <p data-translate="glec_ai_card3_desc">Proprietary data integration standard for analog truck sensors, enabling extended embedding weights from legacy vehicle systems</p>
                    </div>

                    <div class="tech-card">
                        <h4 data-translate="glec_ai_card4_title">Urgency-based Inference</h4>
                        <p data-translate="glec_ai_card4_desc">Context-aware AI that prioritizes safety and carbon reduction with differential sensitivity, delivered through real-time voice agent</p>
                    </div>
                </div>

                <div class="tech-stats">
                    <div class="stat-item">
                        <span class="stat-number">40%</span>
                        <span class="stat-label" data-translate="glec_ai_stat1">Accident Reduction</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-number">20B</span>
                        <span class="stat-label" data-translate="glec_ai_stat2">Parameters</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-number"><100ms</span>
                        <span class="stat-label" data-translate="glec_ai_stat3">Response Time</span>
                    </div>
                </div>
            </div>

            <!-- GLEC API Technology -->
            <div class="tech-block">
                <div class="tech-header">
                    <h3 class="tech-title" data-translate="glec_api_title">GLEC API - ISO-14083 Carbon Measurement Platform</h3>
                    <span class="tech-badge" data-translate="carbon_neutral_badge">CARBON NEUTRAL</span>
                </div>

                <!-- GLEC API Demo Video -->
                <div class="tech-video-container" style="width: 700px; height: 700px; max-width: 100%; margin: 20px auto; padding: 20px; box-sizing: border-box; display: flex; align-items: center; justify-content: center;">
                    <video class="tech-video" style="width: 700px; height: 700px; max-width: 100%; max-height: 100%; object-fit: contain; display: block;" autoplay muted loop playsinline preload="auto" id="glecApiVideo">
                        <source src="assets/videos/GLEC_API_video.mov" type="video/quicktime">
                        <source src="assets/videos/GLEC_API_video.mov" type="video/mp4">
                        Your browser does not support the video tag.
                    </video>
                </div>

                <div class="tech-grid">
                    <div class="tech-card">
                        <h4 data-translate="glec_api_card1_title">ISO-14083 Standard</h4>
                        <p data-translate="glec_api_card1_desc">Complete API implementation of international freight carbon emission measurement standard for global compliance</p>
                    </div>

                    <div class="tech-card">
                        <h4 data-translate="glec_api_card2_title">Real-time Quantification</h4>
                        <p data-translate="glec_api_card2_desc">Instant carbon footprint calculation enabling eco-driving awareness and behavior modification for drivers</p>
                    </div>

                    <div class="tech-card">
                        <h4 data-translate="glec_api_card3_title">Supply Chain Reporting</h4>
                        <p data-translate="glec_api_card3_desc">Enterprise-grade carbon emission reporting for regulatory compliance and sustainability initiatives</p>
                    </div>

                    <div class="tech-card">
                        <h4 data-translate="glec_api_card4_title">Carbon Credit Infrastructure</h4>
                        <p data-translate="glec_api_card4_desc">Core platform for transport carbon credit issuance, enabling monetization of emission reductions</p>
                    </div>
                </div>

                <div class="tech-integration">
                    <h4 data-translate="glec_api_integration_title">Seamless DTG Integration</h4>
                    <p data-translate="glec_api_integration_desc">GLEC API works in perfect harmony with GLEC DTG hardware, creating a comprehensive ecosystem for sustainable logistics transformation. Real-time data from vehicles flows through our API, providing actionable insights for both drivers and fleet managers.</p>
                </div>
            </div>
        </div>
    </section>

    <section class="solutions-section" id="solutions">
        <div class="section-container">
            <div class="section-header">
                <span class="section-label" data-translate="solutions_label">OUR SOLUTIONS</span>
                <h2 class="section-title" data-translate="solutions_title">Solutions & Development Status</h2>
                <p class="section-description" data-translate="solutions_description">
                    Cutting-edge green logistics solutions under development
                </p>
            </div>

            <div class="solutions-grid">
                <!-- eFuel Solution -->
                <div class="solution-card featured">
                    <div class="solution-status">
                        <span class="status-badge development" data-translate="status_development">Under Development</span>
                        <span class="launch-date" data-translate="launch_march_2026">Launch: March 2026</span>
                    </div>
                    <div class="solution-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" width="120" height="120">
                            <defs>
                                <linearGradient id="leafGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                                    <stop offset="0%" style="stop-color:#4ade80;stop-opacity:1" />
                                    <stop offset="100%" style="stop-color:#22c55e;stop-opacity:1" />
                                </linearGradient>
                            </defs>
                            <circle cx="100" cy="100" r="90" fill="rgba(74, 222, 128, 0.1)" stroke="url(#leafGradient)" stroke-width="2"/>
                            <path d="M100 40 Q130 60 140 100 Q130 140 100 160 Q70 140 60 100 Q70 60 100 40 Z"
                                  fill="url(#leafGradient)" opacity="0.9"/>
                            <path d="M100 50 L100 150 M80 90 Q100 95 120 90"
                                  stroke="#ffffff" stroke-width="3" stroke-linecap="round" fill="none" opacity="0.8"/>
                        </svg>
                    </div>
                    <h3 class="solution-title" data-translate="efuel_title">eFuel</h3>
                    <p class="solution-subtitle" data-translate="efuel_subtitle">Freight Carbon Monitoring Solution</p>
                    <div class="solution-funding">
                        <span class="funding-badge" data-translate="tips_program">🏆 TIPS R&D Program 2024</span>
                    </div>
                    <ul class="solution-features">
                        <li data-translate="efuel_feature_1">Real-time carbon emission monitoring</li>
                        <li data-translate="efuel_feature_2">Scope 3 emissions management</li>
                        <li data-translate="efuel_feature_3">ISO-14083 standard compliance</li>
                        <li data-translate="efuel_feature_4">WMS/TMS system integration</li>
                        <li data-translate="efuel_feature_5">Automated CDP, SBT, CBAM reporting</li>
                    </ul>
                </div>

                <!-- GLEC DTG Solution -->
                <div class="solution-card featured">
                    <div class="solution-status">
                        <span class="status-badge development" data-translate="status_development">Under Development</span>
                        <span class="launch-date" data-translate="launch_march_2026">Launch: March 2026</span>
                    </div>
                    <div class="solution-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" width="120" height="120">
                            <defs>
                                <linearGradient id="truckGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                                    <stop offset="0%" style="stop-color:#60a5fa;stop-opacity:1" />
                                    <stop offset="100%" style="stop-color:#3b82f6;stop-opacity:1" />
                                </linearGradient>
                            </defs>
                            <circle cx="100" cy="100" r="90" fill="rgba(96, 165, 250, 0.1)" stroke="url(#truckGradient)" stroke-width="2"/>
                            <!-- Truck body -->
                            <rect x="50" y="80" width="60" height="40" fill="url(#truckGradient)" rx="5"/>
                            <rect x="110" y="70" width="35" height="50" fill="url(#truckGradient)" rx="5"/>
                            <!-- Wheels -->
                            <circle cx="70" cy="125" r="10" fill="#1e3a8a" stroke="#60a5fa" stroke-width="2"/>
                            <circle cx="125" cy="125" r="10" fill="#1e3a8a" stroke="#60a5fa" stroke-width="2"/>
                            <!-- AI indicator -->
                            <circle cx="130" cy="85" r="8" fill="#22d3ee" opacity="0.8"/>
                            <text x="130" y="90" font-size="12" fill="#ffffff" text-anchor="middle" font-weight="bold">AI</text>
                        </svg>
                    </div>
                    <h3 class="solution-title">GLEC DTG</h3>
                    <p class="solution-subtitle" data-translate="dtg_subtitle_full">Digital Tachograph</p>
                    <div class="solution-funding">
                        <span class="funding-badge" data-translate="env_program">🏆 Environmental Tech Program 2025</span>
                    </div>
                    <ul class="solution-features">
                        <li data-translate="dtg_feature_1">Next-gen vehicle operation recorder</li>
                        <li data-translate="dtg_feature_2">LTE-based automatic data collection</li>
                        <li data-translate="dtg_feature_3">Real-time carbon emission measurement</li>
                        <li data-translate="dtg_feature_4">Touch smart display interface</li>
                        <li data-translate="dtg_feature_5">Qualcomm SC200E AP (8GB RAM + 32GB HDD)</li>
                    </ul>
                </div>

                <!-- Carbon API Console Solution -->
                <div class="solution-card">
                    <div class="solution-status">
                        <span class="status-badge development" data-translate="status_development">Under Development</span>
                        <span class="launch-date" data-translate="launch_jan_2026">Launch: January 2026</span>
                    </div>
                    <div class="solution-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" width="120" height="120">
                            <defs>
                                <linearGradient id="apiGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                                    <stop offset="0%" style="stop-color:#fbbf24;stop-opacity:1" />
                                    <stop offset="100%" style="stop-color:#f59e0b;stop-opacity:1" />
                                </linearGradient>
                            </defs>
                            <circle cx="100" cy="100" r="90" fill="rgba(251, 191, 36, 0.1)" stroke="url(#apiGradient)" stroke-width="2"/>
                            <!-- Lightning bolt symbol -->
                            <path d="M110 50 L80 100 L100 100 L90 150 L130 95 L105 95 Z"
                                  fill="url(#apiGradient)" opacity="0.9"/>
                            <!-- Data flow lines -->
                            <circle cx="60" cy="80" r="5" fill="#fbbf24" opacity="0.6"/>
                            <circle cx="140" cy="80" r="5" fill="#fbbf24" opacity="0.6"/>
                            <circle cx="60" cy="120" r="5" fill="#fbbf24" opacity="0.6"/>
                            <circle cx="140" cy="120" r="5" fill="#fbbf24" opacity="0.6"/>
                            <line x1="65" y1="80" x2="95" y2="90" stroke="#fbbf24" stroke-width="2" opacity="0.4"/>
                            <line x1="135" y1="80" x2="115" y2="90" stroke="#fbbf24" stroke-width="2" opacity="0.4"/>
                        </svg>
                    </div>
                    <h3 class="solution-title">Carbon API Console</h3>
                    <p class="solution-subtitle" data-translate="api_subtitle">Logistics Carbon Calculation API</p>
                    <ul class="solution-features">
                        <li data-translate="api_feature_1">48 APIs for carbon calculation</li>
                        <li data-translate="api_feature_2">0.5 second response time</li>
                        <li data-translate="api_feature_3">ISO-14083 standard engine</li>
                        <li data-translate="api_feature_4">Shipper/carrier system integration</li>
                        <li data-translate="api_feature_5">Supports all transport modes</li>
                    </ul>
                </div>
            </div>
        </div>
