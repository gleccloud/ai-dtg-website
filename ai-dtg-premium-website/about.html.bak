    <section class="company-overview-section" id="company-overview">
        <div class="section-container">
            <div class="section-header">
                <span class="section-label" data-translate="company_label">ABOUT US</span>
                <h2 class="section-title" data-translate="company_title">Company Overview</h2>
            </div>

            <div class="company-content">
                <div class="company-info-grid">
                    <div class="company-info-item">
                        <div class="info-label" data-translate="founded_label">Founded</div>
                        <div class="info-value">2023</div>
                        <div class="info-detail" data-translate="founded_detail">Startup</div>
                    </div>

                    <div class="company-info-item">
                        <div class="info-label" data-translate="location_label">Location</div>
                        <div class="info-value" data-translate="location_value">South Korea</div>
                        <div class="info-detail" data-translate="location_detail">Seoul HQ</div>
                    </div>

                    <div class="company-info-item">
                        <div class="info-label" data-translate="specialization_label">Specialization</div>
                        <div class="info-value" data-translate="specialization_value">Green Logistics</div>
                        <div class="info-detail" data-translate="specialization_detail">ISO-14083</div>
                    </div>
                </div>

                <div class="company-vision">
                    <h3 class="vision-title" data-translate="vision_title">Our Vision</h3>
                    <p class="vision-text" data-translate="vision_text">
                        "Korea's only logistics international standard tech company supporting green logistics services"
                    </p>
                </div>

                <div class="company-mission">
                    <h3 class="mission-title" data-translate="mission_title">Our Mission</h3>
                    <p class="mission-text" data-translate="mission_text">
                        Building a sustainable logistics ecosystem and establishing a carbon circulation structure through international standard-based technology and consulting
                    </p>
                </div>

                <div class="company-values">
                    <h3 class="values-title" data-translate="values_title">Core Values</h3>
                    <div class="values-grid">
                        <div class="value-card">
                            <div class="value-icon">🌐</div>
                            <h4 class="value-name" data-translate="value_standards">International Standards</h4>
                            <p class="value-desc" data-translate="value_standards_desc">ISO-14083 compliant solutions</p>
                        </div>

                        <div class="value-card">
                            <div class="value-icon">⚡</div>
                            <h4 class="value-name" data-translate="value_innovation">Innovation</h4>
                            <p class="value-desc" data-translate="value_innovation_desc">Next-gen DTG with AI capabilities</p>
                        </div>

                        <div class="value-card">
                            <div class="value-icon">🌱</div>
                            <h4 class="value-name" data-translate="value_sustainability">Sustainability</h4>
                            <p class="value-desc" data-translate="value_sustainability_desc">Green logistics transformation</p>
                        </div>

                        <div class="value-card">
                            <div class="value-icon">🤝</div>
                            <h4 class="value-name" data-translate="value_partnership">Partnership</h4>
                            <p class="value-desc" data-translate="value_partnership_desc">Global collaboration network</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="team-section" id="team">
        <div class="section-container">
            <div class="section-header">
                <span class="section-label" data-translate="team_label">OUR TEAM</span>
