    <section class="timeline-section" id="timeline">
        <div class="section-container">
            <div class="section-header">
                <span class="section-label" data-translate="timeline_label">ROADMAP</span>
                <h2 class="section-title" data-translate="timeline_title">Development Timeline</h2>
                <p class="section-description" data-translate="timeline_description">
                    Our journey from foundation to innovation in green logistics
                </p>
            </div>

            <div class="timeline-container">
                <div class="timeline-line"></div>

                <!-- 2023 -->
                <div class="timeline-item">
                    <div class="timeline-marker">
                        <div class="timeline-dot"></div>
                        <div class="timeline-year">2023</div>
                    </div>
                    <div class="timeline-content">
                        <h3 class="timeline-event-title" data-translate="timeline_2023_title">GLEC Inc. Founded</h3>
                        <p class="timeline-event-desc" data-translate="timeline_2023_desc">
                            Established as Korea's specialized logistics carbon tech startup
                        </p>
                        <div class="timeline-highlights">
                            <span class="highlight-badge" data-translate="timeline_2023_highlight1">🏢 Company Establishment</span>
                            <span class="highlight-badge" data-translate="timeline_2023_highlight2">🎯 Vision Setting</span>
                        </div>
                    </div>
                </div>

                <!-- 2024 -->
                <div class="timeline-item featured">
                    <div class="timeline-marker">
                        <div class="timeline-dot"></div>
                        <div class="timeline-year">2024</div>
                    </div>
                    <div class="timeline-content">
                        <h3 class="timeline-event-title" data-translate="timeline_2024_title">TIPS R&D Program Selection</h3>
                        <p class="timeline-event-desc" data-translate="timeline_2024_desc">
                            Selected by Ministry of SMEs and Startups for TIPS R&D Program
                        </p>
                        <div class="timeline-highlights">
